<odoo>

    <record id="importer_source_api_view_form" model="ir.ui.view">
        <field name="name">importer.source.api.view.form</field>
        <field name="model">import.source.api</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="company_id" />
                    <field name="enviroment" />
                    <field name="enviroment_url" />
                    <field name="type_request" groups="base.group_no_one" />
                    <field name="url" />
                    <field name="type_authorization" />
                    <field
                        name="username"
                        invisible="type_authorization != 'basic_auth'"
                        required="type_authorization == 'basic_auth'"
                    />
                    <field
                        name="password"
                        type="password"
                        invisible="type_authorization != 'basic_auth'"
                        required="type_authorization == 'basic_auth'"
                    />
                    <field
                        name="type_of_token"
                        invisible="type_authorization != 'token'"
                        required="type_authorization == 'token'"
                    />
                    <field
                        name="model_id"
                        invisible="type_of_token == 'manual'"
                        required="type_of_token != 'manual'"
                    />
                    <field name="field_ids" invisible="1" />
                    <field
                        name="field_id"
                        invisible="type_of_token != 'model_field'"
                        required="type_of_token == 'model_field'"
                    />
                    <field
                        name="function_name"
                        invisible="type_of_token != 'model_function'"
                        required="type_of_token == 'model_function'"
                    />
                    <field
                        name="token"
                        readonly="type_of_token != 'manual'"
                        invisible="type_authorization != 'token'"
                        required="type_authorization == 'token' and type_of_token == 'manual'"
                    />
                </group>
                <notebook>
                    <page string="Params" name="source_api_params">
                        <field
                            name="param_ids"
                            nolabel="1"
                            context="{'tree_view_ref': 'connector_importer.source_api_value_view_tree'}"
                        />
                    </page>
                    <page string="Headers" name="source_api_headers">
                        <field
                            name="header_ids"
                            nolabel="1"
                            context="{'tree_view_ref': 'connector_importer.source_api_value_view_tree'}"
                        />
                    </page>
                </notebook>
            </form>
        </field>
    </record>

</odoo>
